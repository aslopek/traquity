{
  "name": "traquity",
  "productName": "TraQuity",
  "private": true,
  "version": "1.1.1",
  "description": "Angular client for the TraQuity API",
  "author": "Armin Slopek",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aslopek/traquity"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "test": "npm run test:angular && npm run test:electron",
    "test:angular": "jest --config jest.angular.config.ts",
    "test:electron": "tsc -p tsconfig.electron.json && jest --config jest.electron.config.ts",
    "build": "npm run clean && npm run generate && ng build --base-href ./ && npm run licenses:generate",
    "licenses:generate": "node scripts/generate-third-party-licenses.js",
    "licenses:check": "node scripts/check-third-party-licenses.js",
    "clean": "npm run clean:dist && npm run clean:electron && npm run clean:gen",
    "clean:dist": "npx rimraf dist",
    "clean:electron": "npx rimraf out && npx rimraf resources",
    "clean:gen": "npx rimraf src/gen",
    "electron:start": "npx electron-forge start",
    "electron:pack": "npx electron-forge package && npx rimraf resources",
    "electron:make": "npx electron-forge make",
    "generate": "npx @openapitools/openapi-generator-cli generate",
    "serve": "npx @angular/cli serve",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@fontsource/noto-color-emoji": "^5.3.1",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.46.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cdk": "^22.1.3",
    "@angular/cli": "^22.1.5",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.3",
    "@babel/preset-env": "^8.0.2",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@ngrx/component": "^21.0.1",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/node": "^24.13.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "electron": "^43.4.1",
    "electron-squirrel-startup": "^1.0.0",
    "expect": "^30.4.1",
    "html2canvas-pro": "^2.3.9",
    "jest": "^30.4.2",
    "ngx-echarts": "^22.0.0",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.3.0",
    "typescript": "^6.0.3"
  }
}
